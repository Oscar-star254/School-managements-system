generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum SaleStatus {
  COMPLETED
  HELD
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  GIFT_CARD
  STORE_CREDIT
}

enum MovementType {
  SALE
  PURCHASE
  ADJUSTMENT
  TRANSFER
  RETURN
  WASTAGE
}

model Business {
  id String @id @default(cuid())
  name String
  stores Store[]
  users User[]
  roles Role[]
  products Product[]
  categories Category[]
  suppliers Supplier[]
  customers Customer[]
  sales Sale[]
  taxRates TaxRate[]
  expenses Expense[]
  auditLogs AuditLog[]
  settings Settings?
  createdAt DateTime @default(now())
}

model Store {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name String
  address String?
  users User[]
  shifts Shift[]
  stockLevels StockLevel[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  sales Sale[]
  expenses Expense[]
}

model Role {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name String
  users User[]
  permissions Permission[]
  @@unique([businessId, name])
}

model Permission {
  id String @id @default(cuid())
  roleId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  action String
  allowed Boolean @default(true)
  approvalLimit Decimal? @db.Decimal(12, 2)
  @@unique([roleId, action])
}

model User {
  id String @id @default(cuid())
  businessId String
  storeId String?
  roleId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id])
  role Role @relation(fields: [roleId], references: [id])
  name String
  email String @unique
  passwordHash String
  pinHash String?
  active Boolean @default(true)
  shifts Shift[]
  sales Sale[]
  movements StockMovement[]
  auditLogs AuditLog[]
}

model Shift {
  id String @id @default(cuid())
  storeId String
  userId String
  store Store @relation(fields: [storeId], references: [id])
  user User @relation(fields: [userId], references: [id])
  status String @default("OPEN")
  openingFloat Decimal @db.Decimal(12, 2)
  expectedCash Decimal? @db.Decimal(12, 2)
  countedCash Decimal? @db.Decimal(12, 2)
  openedAt DateTime @default(now())
  closedAt DateTime?
  sales Sale[]
}

model Category {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name String
  sortOrder Int @default(0)
  products Product[]
  @@unique([businessId, name])
}

model Product {
  id String @id @default(cuid())
  businessId String
  categoryId String?
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  name String
  sku String
  barcode String?
  cost Decimal @db.Decimal(12, 2)
  price Decimal @db.Decimal(12, 2)
  taxClass String @default("standard")
  unit String @default("each")
  imageUrl String?
  reorderLevel Decimal @default(5) @db.Decimal(12, 3)
  active Boolean @default(true)
  variants Variant[]
  stockLevels StockLevel[]
  saleItems SaleItem[]
  movements StockMovement[]
  @@unique([businessId, sku])
  @@index([businessId, name])
  @@index([businessId, barcode])
}

model Variant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name String
  sku String @unique
  barcode String?
  price Decimal? @db.Decimal(12, 2)
  saleItems SaleItem[]
}

model Supplier {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name String
  email String?
  phone String?
  purchaseOrders PurchaseOrder[]
}

model StockLevel {
  id String @id @default(cuid())
  storeId String
  productId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity Decimal @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt
  @@unique([storeId, productId])
}

model StockMovement {
  id String @id @default(cuid())
  storeId String
  productId String
  userId String?
  store Store @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  type MovementType
  quantity Decimal @db.Decimal(12, 3)
  reference String?
  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id String @id @default(cuid())
  storeId String
  supplierId String
  store Store @relation(fields: [storeId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  number String @unique
  status String @default("DRAFT")
  total Decimal @default(0) @db.Decimal(12, 2)
  expectedAt DateTime?
  createdAt DateTime @default(now())
}

model Customer {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name String
  email String?
  phone String?
  points Int @default(0)
  storeCredit Decimal @default(0) @db.Decimal(12, 2)
  tags String[]
  sales Sale[]
  loyaltyTransactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points Int
  reason String
  createdAt DateTime @default(now())
}

model Sale {
  id String @id @default(cuid())
  businessId String
  storeId String
  userId String
  shiftId String
  customerId String?
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id])
  user User @relation(fields: [userId], references: [id])
  shift Shift @relation(fields: [shiftId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  receiptNumber String @unique
  idempotencyKey String @unique
  status SaleStatus @default(COMPLETED)
  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax Decimal @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  items SaleItem[]
  payments Payment[]
  refunds Refund[]
  createdAt DateTime @default(now())
  @@index([businessId, createdAt])
}

model SaleItem {
  id String @id @default(cuid())
  saleId String
  productId String
  variantId String?
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  variant Variant? @relation(fields: [variantId], references: [id])
  quantity Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
}

model Payment {
  id String @id @default(cuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method PaymentMethod
  amount Decimal @db.Decimal(12, 2)
  reference String?
  createdAt DateTime @default(now())
}

model Refund {
  id String @id @default(cuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id])
  amount Decimal @db.Decimal(12, 2)
  reason String
  restocked Boolean @default(false)
  approvedBy String?
  createdAt DateTime @default(now())
}

model Discount {
  id String @id @default(cuid())
  businessId String
  name String
  code String?
  type String
  value Decimal @db.Decimal(12, 2)
  active Boolean @default(true)
  @@unique([businessId, code])
}

model TaxRate {
  id String @id @default(cuid())
  businessId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name String
  rate Decimal @db.Decimal(6, 4)
  inclusive Boolean @default(false)
}

model Expense {
  id String @id @default(cuid())
  businessId String
  storeId String
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id])
  category String
  vendor String?
  amount Decimal @db.Decimal(12, 2)
  receiptUrl String?
  incurredAt DateTime
}

model AuditLog {
  id String @id @default(cuid())
  businessId String
  userId String?
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
  action String
  entity String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([businessId, createdAt])
}

model Settings {
  id String @id @default(cuid())
  businessId String @unique
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currency String @default("USD")
  locale String @default("en-US")
  timezone String @default("America/Los_Angeles")
  receipt Json?
}
